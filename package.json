{
  "name": "proofsnap-verify",
  "version": "2.0.0",
  "description": "Independent verifier for every ProofSnap evidence package (Chrome extension, API, dashboard, matter exports, deliveries) and for any RFC 3161 qualified timestamp or OpenTimestamps proof. Runs in Node and in the browser, no upload.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "proofsnap-verify": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/build-browser.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "refresh-eutl": "node scripts/refresh-eutl.mjs",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm test",
    "prepack": "npm run build"
  },
  "homepage": "https://github.com/proofsnap/proofsnap-verify",
  "bugs": "https://github.com/proofsnap/proofsnap-verify/issues",
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "blockchain",
    "digital-forensics",
    "eidas",
    "eutl",
    "evidence",
    "evidence-package",
    "opentimestamps",
    "proofsnap",
    "rfc3161",
    "sha256",
    "timestamp",
    "trusted-list",
    "verification"
  ],
  "author": "ProofSnap <support@getproofsnap.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/proofsnap/proofsnap-verify"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.4.0"
  }
}
